# Supabase — copy to .env.local and fill in values
# .env.local is gitignored. NEVER commit real keys.

# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://xktiskyatbamqelqzoou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0D7TrarUfrwr0IglCfizbg_7A6v7ui3

# Server-only (NEVER expose to browser — used for admin signup that bypasses email confirm)
# Get from: https://supabase.com/dashboard/project/xktiskyatbamqelqzoou/settings/api
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-dashboard

# Synthetic-email domain used by username-only auth.
# Username "alice" → Supabase auth.users.email = "alice@omg.local"
OMG_AUTH_EMAIL_DOMAIN=omg.local
